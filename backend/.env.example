# =============================================
# BACKEND — Variables de entorno requeridas
# Copiar este archivo como .env en Railway/Render
# =============================================

# Base de datos (Supabase)
# Obtener desde: Project Settings → Database → Connection string (Transaction pooler)
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.tu-project-ref
DB_PASSWORD=tu-password-supabase

# JWT — Generar con: openssl rand -base64 32
# OBLIGATORIO: mínimo 32 caracteres
JWT_SECRET=genera-uno-con-openssl-rand-base64-32

# CORS — URL del frontend (sin barra al final)
CORS_ORIGINS=https://tu-tienda.vercel.app

# MercadoPago — Obtener desde mercadopago.com.ar/developers
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...

# Gmail SMTP — Usar App Password (no la contraseña real)
# Activar 2FA en Gmail → myaccount.google.com/apppasswords
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Gemini IA (Chat del sitio)
# Obtener gratis en: aistudio.google.com → Get API Key
GEMINI_API_KEY=AIza...

# Producción: usar "validate" para no alterar el schema automáticamente
# Desarrollo local: dejar vacío (usa "update" por defecto)
DDL_AUTO=validate
