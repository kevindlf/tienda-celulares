# =============================================
# FRONTEND — Variables de entorno requeridas
# En Vercel: Project Settings → Environment Variables
# Localmente: copiar como .env.local
# =============================================

# URL del backend (Railway en producción, localhost en dev)
NEXT_PUBLIC_API_URL=https://tu-backend.up.railway.app

# MercadoPago — clave pública (NO la clave privada/access token, esa va solo en el backend)
# Obtener en: mercadopago.com.ar → Tus integraciones → Credenciales
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cloudinary — para subida de imágenes de productos
# Obtener en: cloudinary.com → Settings → Upload → Upload presets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu-upload-preset
